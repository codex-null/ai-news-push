# 复制本文件为 .env，填上你自己的值即可（不要带引号）
# 三种配置方式任选其一：① 填这里 ② 环境变量 ③ 脚本顶部 DEFAULTS

# 推送通道：bark（iPhone）/ serverchan（微信）/ email（邮件）
PUSH_CHANNEL=bark

# Bark key：打开 Bark App，首页地址 https://api.day.app/xxxx 末尾的 xxxx
BARK_KEY=
# 自建 Bark 服务端时填你的域名，留空则用官方免费公服
BARK_SERVER=

# —— 用微信通道时填（PUSH_CHANNEL=serverchan）——
SERVERCHAN_KEY=

# —— 用邮件通道时填（PUSH_CHANNEL=email）——
EMAIL_TO=
EMAIL_FROM=
EMAIL_PASS=
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
